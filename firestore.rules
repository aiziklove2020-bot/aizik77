rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields)
    }
    function isString(field) {
      return request.resource.data[field] is string
    }
    function maxLen(field, len) {
      return request.resource.data[field].size() <= len
    }
    function isNonEmpty(field) {
      return request.resource.data[field] is string && request.resource.data[field].size() > 0
    }

    match /parties/{partyId} { allow read, write: if true; }
    match /settings/{document=**} { allow read, write: if true; }
    match /registrations/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['regType', 'selectedParties']);
      allow update, delete: if true;
    }
    match /users/{userId} { allow read, write: if true; }
    match /rssFeeds/{docId} { allow read, write: if true; }
    match /webhookLogs/{docId} { allow read, create, update, delete: if true; }
    match /dbReadLogs/{docId} { allow read, create, update, delete: if true; }
    match /storeProducts/{docId} { allow read, write: if true; }
    match /storeOrders/{docId} {
      allow read: if true;
      allow create: if hasAll(['items', 'createdAt']);
      allow update, delete: if true;
    }
    match /workshops/{workshopId} { allow read, write: if true; }
    match /workshopRegistrations/{docId} { allow read, write: if true; }
    match /supportChat/{sessionId} { allow read, write: if true; }
    match /supportChat/{sessionId}/messages/{messageId} { allow read, write: if true; }
    match /supportChatTelegramMap/{docId} { allow read, write: if true; }
    match /deleteRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
    match /forumSections/{docId} { allow read, write: if true; }
    match /forumTopics/{docId} {
      allow read: if true;
      allow create: if hasAll(['sectionId', 'title', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('title') && maxLen('title', 150)
                    && maxLen('content', 20000) && isString('authorId');
      allow update, delete: if true;
    }
    match /forumReplies/{docId} {
      allow read: if true;
      allow create: if hasAll(['topicId', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('content') && maxLen('content', 20000)
                    && isString('authorId');
      allow update, delete: if true;
    }
    match /forumUsers/{docId} {
      allow read: if true;
      allow create: if hasAll(['nickname', 'password'])
                    && isNonEmpty('nickname') && maxLen('nickname', 30)
                    && isNonEmpty('password');
      allow update, delete: if true;
    }
    match /blogPosts/{docId} {
      allow read: if true;
      allow create: if hasAll(['title', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('title') && maxLen('title', 200)
                    && maxLen('content', 50000) && isString('authorId');
      allow update, delete: if true;
    }
    match /blogComments/{docId} {
      allow read: if true;
      allow create: if hasAll(['postId', 'content', 'authorId'])
                    && isNonEmpty('content') && maxLen('content', 5000)
                    && isString('authorId');
      allow update, delete: if true;
    }
    match /blogAuthorFollows/{docId} {
      allow read: if true;
      allow create: if hasAll(['followerId', 'authorId'])
                    && isString('followerId') && isString('authorId');
      allow update, delete: if true;
    }
    match /bookmarks/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'itemType', 'itemId'])
                    && isString('userId') && isString('itemId')
                    && (request.resource.data.itemType == 'topic'
                        || request.resource.data.itemType == 'blogPost');
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemType == resource.data.itemType
                    && request.resource.data.itemId == resource.data.itemId;
      allow delete: if true;
    }
    match /notifications/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'type', 'read', 'createdAt'])
                    && isString('userId') && request.resource.data.read == false
                    && maxLen('message', 200) && maxLen('refTitle', 100);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }
    match /privateMessages/{docId} {
      allow read: if true;
      allow create: if hasAll(['conversationId', 'senderId', 'receiverId', 'content', 'read', 'createdAt'])
                    && isString('senderId') && isString('receiverId')
                    && request.resource.data.senderId != request.resource.data.receiverId
                    && request.resource.data.read == false
                    && maxLen('content', 2000);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }
    match /conversations/{docId} {
      allow read: if true;
      allow create: if hasAll(['participants', 'lastMessage', 'lastAt', 'lastSenderId'])
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2;
      allow update: if true;
      allow delete: if false;
    }

    // ─── Live Chat ───
    match /chatMessages/{docId} {
      allow read, create, delete: if true;
      allow update: if false;
    }
    match /chatNicknames/{docId} { allow read, write: if true; }
    match /chatBans/{docId} { allow read, write: if true; }
    match /chatAdminLogs/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /chatPinned/{docId} { allow read, write: if true; }
    match /chatPrivateMessages/{docId} { allow read, write: if true; }
    match /chatRooms/{docId} { allow read, write: if true; }
    match /chatSettings/{docId} { allow read, write: if true; }

  }
}
