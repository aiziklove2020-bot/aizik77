rules_version = '2';
// TBDSM — rules aligned with src/firebase/* (forum, blog, PMs, notifications, bookmarks,
// registrations, store, workshops, support chat, etc.). Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function isString(field) {
      return request.resource.data[field] is string;
    }
    function maxLen(field, len) {
      return request.resource.data[field].size() <= len;
    }
    function isNonEmpty(field) {
      return request.resource.data[field] is string && request.resource.data[field].size() > 0;
    }

    // ── Public / Admin collections (no Firebase Auth available) ──
    // These collections are managed by admin panel + public forms.
    // Without Firebase Auth, ownership rules are not possible; structural
    // validation is applied where practical.

    match /parties/{partyId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Saved log from RegistrationForm: couple (malePhone/femalePhone) or single (phone, fullName)
    match /registrations/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['regType', 'selectedParties']);
      allow update, delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /rssFeeds/{docId} {
      allow read, write: if true;
    }

    match /webhookLogs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /dbReadLogs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /storeProducts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /storeOrders/{docId} {
      allow read: if true;
      allow create: if hasAll(['items', 'createdAt']);
      allow update, delete: if true;
    }

    match /workshops/{workshopId} {
      allow read, write: if true;
    }

    match /workshopRegistrations/{docId} {
      allow read, write: if true;
    }

    match /supportChat/{sessionId} {
      allow read, write: if true;
    }

    match /supportChat/{sessionId}/messages/{messageId} {
      allow read, write: if true;
    }

    match /supportChatTelegramMap/{docId} {
      allow read, write: if true;
    }

    match /deleteRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ── Forum ──

    match /forumSections/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /forumTopics/{docId} {
      allow read: if true;
      allow create: if hasAll(['sectionId', 'title', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('title')
                    && maxLen('title', 150)
                    && maxLen('content', 20000)
                    && isString('authorId');
      allow update: if true;
      allow delete: if true;
    }

    match /forumReplies/{docId} {
      allow read: if true;
      allow create: if hasAll(['topicId', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('content')
                    && maxLen('content', 20000)
                    && isString('authorId');
      allow update: if true;
      allow delete: if true;
    }

    match /forumUsers/{docId} {
      allow read: if true;
      allow create: if hasAll(['nickname', 'password'])
                    && isNonEmpty('nickname')
                    && maxLen('nickname', 30)
                    && isNonEmpty('password');
      allow update: if true;
      allow delete: if true;
    }

    // ── Blog ──

    match /blogPosts/{docId} {
      allow read: if true;
      allow create: if hasAll(['title', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('title')
                    && maxLen('title', 200)
                    && maxLen('content', 50000)
                    && isString('authorId');
      allow update: if true;
      allow delete: if true;
    }

    match /blogComments/{docId} {
      allow read: if true;
      allow create: if hasAll(['postId', 'content', 'authorId'])
                    && isNonEmpty('content')
                    && maxLen('content', 5000)
                    && isString('authorId');
      allow update: if true;
      allow delete: if true;
    }

    match /blogAuthorFollows/{docId} {
      allow read: if true;
      allow create: if hasAll(['followerId', 'authorId'])
                    && isString('followerId')
                    && isString('authorId');
      allow update: if true;
      allow delete: if true;
    }

    // ── Bookmarks ──

    match /bookmarks/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'itemType', 'itemId'])
                    && isString('userId')
                    && isString('itemId')
                    && (request.resource.data.itemType == 'topic'
                        || request.resource.data.itemType == 'blogPost');
      // setDoc on an existing bookmark is an update (e.g. retry); keep identity fields stable
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemType == resource.data.itemType
                    && request.resource.data.itemId == resource.data.itemId;
      allow delete: if true;
    }

    // ── Notifications ──

    match /notifications/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'type', 'read', 'createdAt'])
                    && isString('userId')
                    && request.resource.data.read == false
                    && maxLen('message', 200)
                    && maxLen('refTitle', 100);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // ── Private Messages ──

    match /privateMessages/{docId} {
      allow read: if true;
      allow create: if hasAll(['conversationId', 'senderId', 'receiverId', 'content', 'read', 'createdAt'])
                    && isString('senderId')
                    && isString('receiverId')
                    && request.resource.data.senderId != request.resource.data.receiverId
                    && request.resource.data.read == false
                    && maxLen('content', 2000);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // ── Conversations (denormalized metadata) ──

    match /conversations/{docId} {
      allow read: if true;
      allow create: if hasAll(['participants', 'lastMessage', 'lastAt', 'lastSenderId'])
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2;
      allow update: if true;
      allow delete: if false;
    }

    // ── Live Chat (BDSM Chat on aizik77.vercel.app) ──
    // Real-time chat rooms. No Firebase Auth — matches rest of project's model.
    match /chatMessages/{docId} {
      allow read: if true;
      allow create: if hasAll(['text', 'room', 'user', 'userId', 'createdAt'])
                    && isNonEmpty('text')
                    && maxLen('text', 2000)
                    && isString('room')
                    && maxLen('room', 100)
                    && isString('user')
                    && maxLen('user', 100)
                    && isString('userId');
      allow update: if false;
      allow delete: if true;
    }
  }
}
