rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // פונקציה לבדיקה אם המשתמש מחובר
    function isSignedIn() {
      return request.auth != null;
    }
    
    // פונקציה לבדיקה אם המשתמש הוא אדמין
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // פונקציה לבדיקה אם המשתמש הוא בעל המשאב
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // משתמשים
    match /users/{userId} {
      // כולם יכולים לקרוא משתמשים מחוברים
      allow read: if isSignedIn();
      
      // רק בעל החשבון יכול לערוך את הפרטים שלו
      allow update: if isOwner(userId);
      
      // רק אדמינים יכולים למחוק משתמשים או לשנות תפקידים
      allow delete: if isAdmin();
      
      // יצירת משתמש חדש - רק אם זה החשבון של המשתמש עצמו
      allow create: if isSignedIn() && request.auth.uid == userId;
    }
    
    // הודעות בצ'אט
    match /messages/{messageId} {
      // כל משתמש מחובר יכול לקרוא הודעות
      allow read: if isSignedIn();
      
      // כל משתמש מחובר יכול ליצור הודעה
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.timestamp == request.time;
      
      // רק בעל ההודעה או אדמין יכול למחוק
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // רק בעל ההודעה יכול לערוך (תוך 5 דקות)
      allow update: if isOwner(resource.data.userId) && 
                    request.time < resource.data.timestamp + duration.value(5, 'm');
    }
    
    // הודעות פרטיות
    match /privateMessages/{messageId} {
      // רק השולח והמקבל יכולים לקרוא
      allow read: if isSignedIn() && 
                  (resource.data.from == request.auth.uid || 
                   resource.data.to == request.auth.uid);
      
      // רק משתמשים רשומים יכולים לשלוח (לא אורחים)
      allow create: if isSignedIn() && 
                    request.resource.data.from == request.auth.uid &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'guest';
      
      // רק השולח יכול למחוק
      allow delete: if isOwner(resource.data.from);
    }
    
    // חדרי צ'אט
    match /rooms/{roomId} {
      // כולם יכולים לקרוא את רשימת החדרים
      allow read: if isSignedIn();
      
      // רק אדמינים יכולים ליצור/לערוך/למחוק חדרים
      allow create, update, delete: if isAdmin();
    }
    
    // סטטוס משתמשים מחוברים (online/offline)
    match /onlineUsers/{userId} {
      // כולם יכולים לקרוא מי מחובר
      allow read: if isSignedIn();
      
      // רק המשתמש עצמו יכול לעדכן את הסטטוס שלו
      allow write: if isOwner(userId);
    }
    
    // באנים (חסימות)
    match /bans/{userId} {
      // כולם יכולים לקרוא מי חסום
      allow read: if isSignedIn();
      
      // רק אדמינים יכולים לחסום/לבטל חסימה
      allow write: if isAdmin();
    }
  }
}
