{
  "name": "party-registration-app",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && node scripts/generate-sitemap.mjs && node scripts/verify-vercel-admin-env.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore:chat": "firebase deploy --only firestore --config firebase.chat.json -P chat",
    "migrate:live-chat-firestore": "node scripts/migrate-live-chat-firestore.mjs",
    "migrate:chat:supabase": "node scripts/migrate-chat-to-supabase.mjs",
    "migrate:chat:supabase:dry": "node scripts/migrate-chat-to-supabase.mjs --dry-run",
    "migrate:chat:validate": "node scripts/validate-chat-migration.mjs",
    "test:coverage": "vitest run --coverage",
    "build:app": "npm run build && cd app && npx cap sync",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "sync-app-icons": "node scripts/sync-app-icons.mjs",
    "postinstall": "node scripts/ensure-rolldown-native.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-virtual": "^3.13.24",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.3.3",
    "firebase": "^10.7.1",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.562.0",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "resend": "^6.12.3",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.23",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
